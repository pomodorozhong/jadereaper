{
  "name": "jadereaper",
  "private": true,
  "description": "Dev tools for Jade Reaper. The game itself needs no install or build step.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "fonts:subset": "node tools/fonts.mjs subset",
    "fonts:check": "node tools/fonts.mjs check",
    "start": "node tools/serve.mjs",
    "smoke": "node tools/smoke.mjs",
    "test": "node --test tools/*.test.mjs",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "fontkit": "2.0.4",
    "playwright": "1.64.1",
    "subset-font": "2.9.0"
  }
}
